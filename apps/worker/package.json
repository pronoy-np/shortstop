{
  "name": "@shortstop/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "node scripts/check-migrations.ts && tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "cpu-sample": "node scripts/cpu-sample.ts",
    "eval": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@shortstop/shared": "workspace:*",
    "hono": "^4.13.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "postal-mime": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  }
}
