{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "jsx": "react-jsx",
    "allowJs": false,
    "plugins": [{ "name": "next" }],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["next-env.d.ts", "src", "app", "test", "e2e", "evals", "scripts", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".open-next", ".wrangler"]
}
